GEMINI_API_KEY=your_key_here
MONGODB_URI=
MONGODB_DB=privacyguard

# Local development stays on loopback and permits extension origins only.
APP_ENV=development
PRIVACYGUARD_API_KEY=
PRIVACYGUARD_ALLOWED_ORIGINS=
PRIVACYGUARD_HTTPS_ONLY=false
PRIVACYGUARD_MAX_BODY_BYTES=524288
PRIVACYGUARD_RATE_LIMIT=60
PRIVACYGUARD_RATE_WINDOW_SECONDS=60
PRIVACYGUARD_RETENTION_DAYS=30
