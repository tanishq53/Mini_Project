GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
MONGODB_URI=
MONGODB_DB=privacyguard
GOOGLE_SAFE_BROWSING_API_KEY=your_key_here
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-web-app-id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/firebase-service-account.json
# Local development stays on loopback and permits extension origins only.
APP_ENV=development
PRIVACYGUARD_API_KEY=
PRIVACYGUARD_ALLOWED_ORIGINS=
PRIVACYGUARD_HTTPS_ONLY=false
PRIVACYGUARD_MAX_BODY_BYTES=524288
PRIVACYGUARD_RATE_LIMIT=60
PRIVACYGUARD_RATE_WINDOW_SECONDS=60
PRIVACYGUARD_RETENTION_DAYS=30
